{
  "name": "ableway-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --fileParallelism=false",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "env:check": "tsx --conditions=react-server scripts/check-env.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "telegram:webhook": "tsx --conditions=react-server scripts/telegram-webhook.ts"
    "speech:smoke": "tsx --conditions=react-server scripts/speech-smoke.ts",
    "eval:assistant": "tsx --conditions=react-server scripts/run-assistant-eval.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "drizzle-orm": "^0.45.4",
    "grammy": "^1.46.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "postcss": "^8.5.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-pgvector": "^0.0.17",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vitest-axe": "^0.1.0"
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  }
}
