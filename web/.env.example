# Copy this file to .env.local and fill in real values.
# Never commit .env.local. None of these may use a NEXT_PUBLIC_ prefix.
# The server will not start if a required value is missing or invalid.

# Neon Postgres connection string
DATABASE_URL=postgresql://neondb_owner:npg_Y4Q1nLcsiHft@ep-icy-lake-bdz0p3qz-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Auth.js secret, at least 32 characters. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google Gemini API key
GEMINI_API_KEY=

# Speech-to-text and text-to-speech provider keys
STT_API_KEY=
TTS_API_KEY=

# Telegram bot token from @BotFather, like 123456789:ABC...
TELEGRAM_BOT_TOKEN=
# 16-256 characters: letters, numbers, _ and -. Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Optional: SMS provider key (for one-time codes)
SMS_API_KEY=

# Shared secret for scheduled jobs (job alerts), at least 16 characters
CRON_SECRET=

# Public base URL of this app, no trailing slash
APP_URL=http://localhost:3000
