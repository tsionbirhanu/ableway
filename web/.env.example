# Copy this file to .env.local and fill in real values.
# Never commit .env.local. None of these may use a NEXT_PUBLIC_ prefix.
# The server will not start if a required value is missing or invalid.

# Neon Postgres connection string
DATABASE_URL=postgresql://neondb_owner:npg_Y4Q1nLcsiHft@ep-icy-lake-bdz0p3qz-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Auth.js secret, at least 32 characters. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google Gemini API key
GEMINI_API_KEY=

# Speech-to-text and text-to-speech provider keys
STT_API_KEY=
TTS_API_KEY=

# Telegram bot token from @BotFather, like 123456789:ABC...
TELEGRAM_BOT_TOKEN=
# 16-256 characters: letters, numbers, _ and -. Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Optional: SMS provider key (for one-time codes)
SMS_API_KEY=
SMS_ENABLED=false

# Shared secret for scheduled jobs (job alerts), at least 16 characters
CRON_SECRET=

# Public base URL of this app, no trailing slash
APP_URL=http://localhost:3000

# ---------- Speech ----------
# "gemini" (uses GEMINI_API_KEY), "azure" (needs STT_API_KEY, TTS_API_KEY, AZURE_SPEECH_REGION),
# or "mock" for tests. Speech is English and Amharic only.
# The same Azure Speech key can be used for STT_API_KEY and TTS_API_KEY.
SPEECH_PROVIDER=mock
# Azure region of your Speech resource, for example eastus or westeurope
AZURE_SPEECH_REGION=
# Below this confidence (0 to 1) the learner is asked to repeat
SPEECH_LOW_CONFIDENCE_THRESHOLD=0.65
# Opt-in: keep voice recordings (personal data). Off by default.
SPEECH_RETAIN_AUDIO=false
SPEECH_RETENTION_DIR=.data/speech-retention
SPEECH_RETENTION_DAYS=30
# Optional: path to your own ffmpeg (the bundled ffmpeg-static is used otherwise)
FFMPEG_PATH=
